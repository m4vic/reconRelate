# Never commit a real .env with live API keys. Copy this file to .env locally only.

RECONRELATE_DB_PATH=
# -1 = unlimited BFS depth (until queue empty / GLOBAL_MAX_NODES). >=0 = cap at that depth.
DEFAULT_MAX_DEPTH=-1
PIVOT_TOP_K=8
PIVOT_SCORE_THRESHOLD=0.40
MAX_DOMAINS_PER_IDENTIFIER=5
GLOBAL_MAX_NODES=1500
REQUEST_TIMEOUT_SEC=12
RETRY_COUNT=2
# Comma-separated emergency kill switches using names from `reconrelate providers`.
# Example: whoxy,duckduckgo,crtsh
RECONRELATE_DISABLE_PROVIDERS=
# Registration source: auto (RDAP then legacy fallback) | rdap-iana | python-whois
RECONRELATE_SOURCE_WHOIS=auto
# Optional local ProjectDiscovery Subfinder binary and passive source policy.
RECONRELATE_SUBFINDER_PATH=
RECONRELATE_SUBFINDER_SOURCES=crtsh,alienvault,commoncrawl,waybackarchive
RECONRELATE_SUBFINDER_RATE_PER_SECOND=5
# Outer provider deadline; Subfinder itself is terminated after 20 seconds.
RECONRELATE_PROVIDER_SUBFINDER_TIMEOUT_SEC=25
# Opt in to bounded archived root-page evidence during normal scans.
RECONRELATE_HISTORICAL_WEB=false
# SEC requires automated clients to declare an operator and contact address. This is free and is
# sent only to official SEC endpoints, e.g. "Your Name you@example.com".
RECONRELATE_SEC_USER_AGENT=
# Optional per-provider safety ceilings (manifest defaults apply when unset).
# RECONRELATE_PROVIDER_WHOXY_CONCURRENCY=2
# RECONRELATE_PROVIDER_WHOXY_RATE_PER_MINUTE=20
# RECONRELATE_PROVIDER_WHOXY_MAX_REQUESTS=1
# RECONRELATE_PROVIDER_WHOXY_MAX_PAGES=1
# Bounded wait for shared SQLite provider capacity; 0 rejects immediately.
RECONRELATE_PROVIDER_CAPACITY_WAIT_SEC=5
# Provider spend policy. free never instantiates billable adapters. byok also requires the run CLI
# flags --approve-paid and --max-billable-units with a positive ceiling.
RECONRELATE_PROVIDER_TIER=free
RECONRELATE_MAX_PROVIDER_CALLS=500
RECONRELATE_MAX_BILLABLE_UNITS=0

# Model execution ceilings. Cloud is disabled by default and also requires the per-run
# --approve-cloud flag plus a positive --max-cloud-tokens value.
RECONRELATE_LLM_ALLOW_CLOUD=false
RECONRELATE_MAX_MODEL_CALLS=50
RECONRELATE_MAX_MODEL_INPUT_TOKENS=200000
RECONRELATE_MAX_MODEL_OUTPUT_TOKENS=25600
RECONRELATE_MAX_CLOUD_TOKENS=0
RECONRELATE_MAX_CLOUD_COST_USD=0
OPENAI_API_KEY=
# Ollama model tag (e.g. qwen3.5:9b). Empty = default qwen3.5:9b in code.
# Use a LiteLLM provider/model identifier for cloud APIs or ollama/<tag> for a local model.
LLM_MODEL=
OLLAMA_API_BASE=http://localhost:11434
LLM_TIMEOUT_SEC=120
PER_DOMAIN_TIMEOUT_SEC=180

# After each successful `run`, write .tree.txt, .graph.json, .report.md (no extra `export` step)
RECONRELATE_AUTO_SAVE_ARTIFACTS=true
RECONRELATE_ARTIFACTS_DIR=artifacts

# Run preset: quick | deep (fan-out, subdomain enum depth, queue cap)
RECONRELATE_RUN_MODE=deep
# Override preset (1/true = try HackerTarget before crt.sh)
RECONRELATE_PREFER_FAST_SUBDOMAIN=
# Caps (integers; unset = use preset defaults)
RECONRELATE_MAX_SUBDOMAINS_FETCHED=
RECONRELATE_MAX_SUBDOMAIN_GRAPH_NODES=
RECONRELATE_MAX_PENDING_QUEUE=
# Only enumerate subdomains when current BFS depth <= this (0 = root only)
RECONRELATE_SUBDOMAIN_ENUM_MAX_DEPTH=
